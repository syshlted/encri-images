<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- I13: the keys are PrivacySettings', and the defaults its own. -->
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/privacy_header">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="allow_screenshots"
            app:summary="@string/allow_screenshots_summary"
            app:title="@string/allow_screenshots_title" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="show_previews"
            app:summary="@string/show_previews_summary"
            app:title="@string/show_previews_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/general_header">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="edge_tap_navigation_enabled"
            app:summary="@string/edge_tap_navigation_enabled_description"
            app:title="@string/edge_tap_navigation_enable_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/video_header">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="double_tap_to_seek_enabled"
            app:summary="@string/double_tap_to_seek_enabled_description"
            app:title="@string/double_tap_to_seek_enabled_title" />

        <SeekBarPreference
            android:max="30"
            app:defaultValue="10"
            app:dependency="double_tap_to_seek_enabled"
            app:iconSpaceReserved="false"
            app:key="double_tap_to_seek_seconds"
            app:min="5"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/double_tap_to_seek_seconds_description"
            app:title="@string/double_tap_to_seek_seconds_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="hide_native_seek_buttons"
            app:summary="@string/hide_native_seek_buttons_description"
            app:title="@string/hide_native_seek_buttons_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="remember_video_playback_position_enabled"
            app:summary="@string/remember_video_playback_position_enabled_description"
            app:title="@string/remember_video_playback_position_enabled_title" />

    </PreferenceCategory>

    <!-- I19: the notices, as a row of their own; SettingsActivity gives it the screen it opens. -->
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/about_header">

        <Preference
            app:iconSpaceReserved="false"
            app:key="third_party_notices"
            app:summary="@string/notices_summary"
            app:title="@string/notices_title" />

    </PreferenceCategory>

</PreferenceScreen>
